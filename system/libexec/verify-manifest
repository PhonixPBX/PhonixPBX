#!/usr/bin/python3 -I
"""Verify a PhonixPBX update bundle manifest (used by priv install-update).

usage: verify-manifest <dir with manifest.json + manifest.sig> <board> <pubkey.pem>

manifest.sig is the raw 64 byte ed25519 signature over manifest.json, the
public key a PEM SubjectPublicKeyInfo. On success prints "version <v>" and
one "<sha256>  <name>" line per file; exits non-zero on any problem.
"""

import json
import re
import sys

ALLOWED = {"rootfs.squashfs", "vmlinuz", "initramfs", "boot.tar"}
SHA256 = re.compile(r"^[0-9a-f]{64}$")
VERSION = re.compile(r"^[A-Za-z0-9._+~-]{1,64}$")


def fail(msg: str) -> None:
    print(f"verify-manifest: {msg}", file=sys.stderr)
    sys.exit(1)


def main() -> None:
    if len(sys.argv) != 4:
        fail("usage: verify-manifest <dir> <board> <pubkey>")
    directory, board, keyfile = sys.argv[1:]
    from cryptography.exceptions import InvalidSignature
    from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PublicKey
    from cryptography.hazmat.primitives.serialization import load_pem_public_key

    with open(f"{directory}/manifest.json", "rb") as fh:
        raw = fh.read(1024 * 1024)
    with open(f"{directory}/manifest.sig", "rb") as fh:
        sig = fh.read(1024)
    with open(keyfile, "rb") as fh:
        key = load_pem_public_key(fh.read())
    if not isinstance(key, Ed25519PublicKey):
        fail("update key is not an ed25519 public key")
    try:
        key.verify(sig, raw)
    except InvalidSignature:
        fail("invalid signature")
    try:
        manifest = json.loads(raw)
    except ValueError as exc:
        fail(f"invalid manifest: {exc}")
    if not isinstance(manifest, dict):
        fail("invalid manifest")
    if manifest.get("board") != board:
        fail(f"bundle is for board {manifest.get('board')!r}, this is {board!r}")
    version = manifest.get("version")
    if not isinstance(version, str) or not VERSION.match(version):
        fail("invalid version")
    files = manifest.get("files")
    if not isinstance(files, dict) or not files:
        fail("invalid file list")
    print(f"version {version}")
    for name, digest in sorted(files.items()):
        if name not in ALLOWED or not isinstance(digest, str) or not SHA256.match(digest):
            fail(f"invalid file entry {name!r}")
        print(f"{digest}  {name}")


if __name__ == "__main__":
    main()
