#!/bin/sh
# Console front end (spawned by init on tty1 and the serial console, in
# system containers on /dev/console):
#   console <tty>
# Runs the PhonixPBX console menu (phonix tui). Booting with
# "phonix.console=shell" on the kernel command line (needs physical access
# to the boot loader) gives a root shell instead, for service and tests.
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
tty=${1:-tty1}
case "$tty" in *[!A-Za-z0-9]*) exit 1 ;; esac
dev=/dev/$tty

# no such device (e.g. no serial port): stay idle instead of respawning
if [ ! -c "$dev" ] || ! stty -F "$dev" >/dev/null 2>&1; then
	exec sleep 2147483647
fi
exec <"$dev" >"$dev" 2>&1

case "$tty" in
tty[0-9]*) TERM=linux ;;
console)
	# container console (a pseudo terminal set up by LXC/Incus)
	TERM=vt100
	;;
*)
	TERM=vt100
	stty -F "$dev" 115200 sane 2>/dev/null
	;;
esac
export TERM
[ -r /etc/conf.d/phonix ] && . /etc/conf.d/phonix
export PHONIX_DATA_DIR PHONIX_BOOT_DIR PHONIX_PRIVILEGED 2>/dev/null
cd /

for w in $(cat /proc/cmdline); do
	if [ "$w" = phonix.console=shell ]; then
		printf '\nPhonixPBX service shell on %s (phonix.console=shell)\n' "$tty"
		exec setsid -w -c /bin/sh -l
	fi
done

# The menu runs in this session: init started the script as a session
# leader, so opening the terminal above made it the controlling terminal
# (Ctrl-C, password prompts), unless it belongs to another session (a
# container console), then the menu runs without one. Never hand the terminal
# to a separate session (setsid -c): when that session's leader exits, the
# kernel hangs up the terminal for everybody, this script included, and the
# console stays dark. Ctrl-C reaches the whole foreground process group; the
# trap keeps the script alive while the menu handles it.
trap : INT QUIT
started=$(cut -d. -f1 /proc/uptime)
phonix tui
rc=$?
now=$(cut -d. -f1 /proc/uptime)
if [ $rc -ne 0 ] && [ $((now - started)) -lt 5 ]; then
	# the menu is unavailable: show the banner and avoid a respawn loop
	clear 2>/dev/null
	phonix banner 2>/dev/null || cat /etc/issue
	sleep 60
fi
