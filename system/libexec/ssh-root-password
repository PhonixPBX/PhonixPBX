#!/bin/sh
# Set root's password hash from line 2 of /etc/phonix/ssh (SHA-512 crypt,
# generated from System > General). Empty: no password, SSH key logins only.
# Run as root by phonix-apply at boot and by the priv helper on apply;
# /etc/shadow lives on the tmpfs overlay, so this runs on every boot.
set -eu

PATH=/usr/sbin:/usr/bin:/sbin:/bin
CONF=${PHONIX_SSH_CONF:-/etc/phonix/ssh}
SHADOW=${PHONIX_SHADOW:-/etc/shadow}

hash=$(sed -n 2p "$CONF" 2>/dev/null | tr -d '[:space:]')
case "$hash" in
'') hash='*' ;;
'$6$'*)
	case "$hash" in *[!A-Za-z0-9./\$=]*)
		echo "ssh-root-password: invalid password hash" >&2
		exit 1
		;;
	esac
	;;
*)
	echo "ssh-root-password: invalid password hash" >&2
	exit 1
	;;
esac

tmp="$SHADOW.phonix-new"
awk -F: -v OFS=: -v h="$hash" '$1 == "root" { $2 = h } { print }' "$SHADOW" >"$tmp"
chown "$(stat -c %u:%g "$SHADOW")" "$tmp"
chmod "$(stat -c %a "$SHADOW")" "$tmp"
mv -f "$tmp" "$SHADOW"
