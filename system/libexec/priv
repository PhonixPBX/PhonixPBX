#!/bin/sh
# SPDX-FileCopyrightText: 2026 The PhonixPBX contributors
# SPDX-License-Identifier: Apache-2.0
# PhonixPBX privileged helper.
#
# The web process (user "phonix") runs this - and only this - as root:
#   doas -n /usr/libexec/phonix/priv <action> [args]
# (rule in /etc/doas.d/phonix.conf). Every argument is validated again here;
# the action table and STAGED_FILES must match phonix/services/privileged.py.
set -eu

PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
umask 022

LIBEXEC=/usr/libexec/phonix
STAGED=/run/phonix/staged
PRIVTMP=/run/phonix-priv
BOOT_DIR=${PHONIX_PRIV_BOOT_DIR:-/media/boot}
BOARD_FILE=/etc/phonix/board
UPDATE_KEY=/etc/phonix/update-key.pub
MAX_STAGED_SIZE=1048576

# shellcheck source=bootctl.sh
. "$LIBEXEC/bootctl.sh"

log() {
	logger -t phonix-priv -- "$*" 2>/dev/null || true
}

die() {
	echo "priv: $*" >&2
	log "error: $*"
	exit 1
}

# write a line to the kernel log (shows on the console; used as boot marker)
kmsg() {
	printf '<5>phonix: %s\n' "$*" >/dev/kmsg 2>/dev/null || true
}

# same at info level: kernel log only with the default loglevel=6. The boot
# is confirmed after the console menu is up; a notice would be printed below
# its prompt and make the console look stuck. The QEMU tests boot with
# loglevel=7 to see it.
kmsg_info() {
	printf '<6>phonix: %s\n' "$*" >/dev/kmsg 2>/dev/null || true
}

usage() {
	die "usage: priv <action> [args] (see phonix/services/privileged.py)"
}

nargs() {
	[ "$1" -eq "$2" ] || die "action $ACTION takes $1 argument(s)"
}

valid_arg() {
	# same character set as phonix.services.privileged._ARG
	case "$1" in
	'' | *[!A-Za-z0-9_.:/-]*) return 1 ;;
	esac
	[ "${#1}" -le 255 ]
}

# run a command detached from the caller (doas/subprocess must not wait)
detach() {
	setsid sh -c "$1" >/dev/null 2>&1 </dev/null &
}

svc_started() {
	rc-service --quiet "$1" status >/dev/null 2>&1
}

boot_rw() {
	mountpoint -q "$BOOT_DIR" || die "$BOOT_DIR is not mounted"
	mount -o remount,rw "$BOOT_DIR" || die "cannot remount $BOOT_DIR read-write"
	BOOT_REMOUNTED=1
}

boot_ro() {
	sync
	if [ "${BOOT_REMOUNTED:-0}" = 1 ]; then
		mount -o remount,ro "$BOOT_DIR" 2>/dev/null || true
		BOOT_REMOUNTED=0
	fi
}

# base device of the boot disk, e.g. /dev/sda or /dev/mmcblk0p (partition 1 = PHXBOOT)
disk_base() {
	_dev=$(awk -v m="$BOOT_DIR" '$2 == m { print $1; exit }' /proc/mounts)
	case "$_dev" in
	/dev/*1) echo "${_dev%1}" ;;
	*) die "cannot determine the boot disk (boot partition: '${_dev}')" ;;
	esac
}

board() {
	head -n 1 "$BOARD_FILE" 2>/dev/null | tr -cd 'A-Za-z0-9_-'
}

# container boards (lxc-*; oci-* has its own helper): no boot partition, no A/B slots; the
# container host owns network, host name and clock
is_container() {
	case "$(board)" in
	lxc-* | oci-*) return 0 ;;
	esac
	return 1
}

no_slots_in_container() {
	die "PhonixPBX runs in a container (board $(board)): there are no boot slots"
}

# ------------------------------------------------------------------ staged files

# component -> whitelisted target files (identical to STAGED_FILES)
staged_files() {
	case "$1" in
	system:network) echo /etc/network/interfaces /etc/resolv.conf ;;
	system:hostname) echo /etc/hostname /etc/hosts ;;
	system:time) echo /etc/chrony/chrony.conf /etc/timezone ;;
	system:firewall) echo /etc/nftables.nft ;;
	system:ssh) echo /etc/phonix/ssh ;;
	system:mdns) echo /etc/avahi/avahi-daemon.conf /etc/avahi/services/phonix.service /etc/phonix/mdns ;;
	*) return 1 ;;
	esac
}

target_mode() {
	case "$1" in
	/etc/nftables.nft | /etc/phonix/ssh) echo 640 ;;
	*) echo 644 ;;
	esac
}

# group of an installed file (the web process compares /etc/nftables.nft)
target_group() {
	case "$1" in
	/etc/nftables.nft | /etc/phonix/ssh) echo phonix ;;
	*) echo root ;;
	esac
}

# Copy one staged file into place. The staging tree belongs to the
# unprivileged user, so it is read with that user's permissions (no symlink
# or hard link tricks can expose root-only files) into a root-only buffer.
install_one() {
	_target=$1
	_src="$STAGED$_target"
	[ -e "$_src" ] || [ -L "$_src" ] || return 1
	mkdir -p "$PRIVTMP"
	chmod 700 "$PRIVTMP"
	_buf="$PRIVTMP/$(basename "$_target").$$"
	rm -f "$_buf"
	if ! su -s /bin/sh phonix -c 'exec head -c "$1" -- "$2"' phonix "$((MAX_STAGED_SIZE + 1))" "$_src" >"$_buf"; then
		rm -f "$_buf"
		die "cannot read staged file $_src"
	fi
	if [ "$(wc -c <"$_buf")" -gt "$MAX_STAGED_SIZE" ]; then
		rm -f "$_buf"
		die "staged file $_src is too large"
	fi
	if [ "$_target" = /etc/nftables.nft ]; then
		nft -c -f "$_buf" || {
			rm -f "$_buf"
			die "firewall ruleset failed validation"
		}
	fi
	mkdir -p "$(dirname "$_target")"
	chown "root:$(target_group "$_target")" "$_buf"
	chmod "$(target_mode "$_target")" "$_buf"
	mv -f "$_buf" "$_target.priv-new"
	mv -f "$_target.priv-new" "$_target"
	# consume the staged copy (as its owner)
	su -s /bin/sh phonix -c 'rm -f -- "$1"' phonix "$_src" || true
	log "installed $_target"
	return 0
}

lan_interfaces() {
	awk '$1 == "auto" { for (i = 2; i <= NF; i++) if ($i != "lo") print $i }' /etc/network/interfaces
}

activate() {
	case "$1" in
	system:network)
		# reconfigure in the background: the caller's HTTP connection may be
		# on the interface that is being reconfigured
		_ifaces=$(lan_interfaces | tr '\n' ' ')
		for _i in $_ifaces; do
			case "$_i" in *[!A-Za-z0-9_.:-]*) die "invalid interface name $_i" ;; esac
		done
		detach "sleep 2; for i in $_ifaces; do ifdown -f \$i; ifup \$i; done; logger -t phonix-priv 'network reconfigured'"
		;;
	system:hostname)
		hostname -F /etc/hostname
		;;
	system:time)
		_tz=$(head -n 1 /etc/timezone | tr -d '[:space:]')
		case "$_tz" in
		'' | *..* | /* | *[!A-Za-z0-9_+/-]*) die "invalid timezone '$_tz'" ;;
		esac
		[ -f "/usr/share/zoneinfo/$_tz" ] || die "unknown timezone $_tz"
		ln -sfn "/usr/share/zoneinfo/$_tz" /etc/localtime
		if svc_started chronyd; then
			rc-service chronyd restart >/dev/null 2>&1 || die "chronyd restart failed"
		fi
		;;
	system:firewall)
		nft -c -f /etc/nftables.nft || die "firewall ruleset failed validation"
		nft -f /etc/nftables.nft || die "loading the firewall ruleset failed"
		;;
	system:ssh)
		"$LIBEXEC/ssh-root-password" || die "setting the root password failed"
		if [ "$(head -n 1 /etc/phonix/ssh 2>/dev/null)" = on ]; then
			rc-update add dropbear default >/dev/null 2>&1 || true
			svc_started dropbear || rc-service dropbear start >/dev/null 2>&1 || die "starting ssh failed"
		else
			rc-update del dropbear default >/dev/null 2>&1 || true
			! svc_started dropbear || rc-service dropbear stop >/dev/null 2>&1 || true
		fi
		;;
	system:mdns)
		# a changed host name or service file needs a restart (no D-Bus for avahi-set-host-name)
		if [ "$(head -n 1 /etc/phonix/mdns 2>/dev/null)" = on ]; then
			rc-update add phonix-mdns default >/dev/null 2>&1 || true
			rc-service phonix-mdns restart >/dev/null 2>&1 || die "starting mdns failed"
		else
			rc-update del phonix-mdns default >/dev/null 2>&1 || true
			! svc_started phonix-mdns || rc-service phonix-mdns stop >/dev/null 2>&1 || true
		fi
		;;
	esac
}

do_install_staged() {
	_comp=$1
	_files=$(staged_files "$_comp") || die "unknown component $_comp"
	if is_container; then
		case "$_comp" in
		system:network | system:hostname)
			log "$_comp is managed by the container host, not installed"
			echo "$_comp: managed by the container host"
			return 0
			;;
		esac
	fi
	_n=0
	for _f in $_files; do
		if install_one "$_f"; then _n=$((_n + 1)); fi
	done
	activate "$_comp"
	echo "$_comp: installed $_n file(s)"
}

# ------------------------------------------------------------------ updates

bundle_member_ok() { # name board
	case "$2:$1" in
	*:manifest.json | *:manifest.sig) return 0 ;;
	lxc-*:packages.tar | lxc-*:world | lxc-*:image-info) return 0 ;;
	lxc-*:*) return 1 ;;
	*:rootfs.squashfs | *:vmlinuz | *:initramfs | *:boot.tar) return 0 ;;
	*) return 1 ;;
	esac
}

sha256_of() {
	sha256sum "$1" | cut -d' ' -f1
}

# work directory below /data (root only) with the bundle's member list checked
# and its manifest verified: sets WORK, _version and $WORK/sums
bundle_open() { # bundle board required-member...
	_b=$1
	_bb=$2
	shift 2
	mkdir -p /data/tmp
	WORK=$(mktemp -d /data/tmp/update.XXXXXX)
	chmod 700 "$WORK"

	# member names are checked before anything is extracted
	tar -tf "$_b" >"$WORK/members" || die "bundle is not a tar archive"
	while IFS= read -r _m; do
		bundle_member_ok "$_m" "$_bb" || die "unexpected bundle member '$_m'"
	done <"$WORK/members"
	for _m in manifest.json manifest.sig "$@"; do
		grep -qx "$_m" "$WORK/members" || die "bundle lacks $_m"
	done

	mkdir "$WORK/x"
	(cd "$WORK/x" && tar -xf "$_b" manifest.json manifest.sig) || die "cannot extract manifest"
	# signature (ed25519 over manifest.json), board and checksum list
	python3 -I "$LIBEXEC/verify-manifest" "$WORK/x" "$_bb" "$UPDATE_KEY" >"$WORK/sums" ||
		die "bundle signature/manifest verification failed"
	_version=$(sed -n 's/^version //p' "$WORK/sums")
	sed -i '/^version /d' "$WORK/sums"
}

# extract members into the work directory (root only, so the files cannot
# change after the check) and compare them with the manifest
bundle_extract() { # bundle member...
	_b=$1
	shift
	(cd "$WORK/x" && tar -xf "$_b" "$@") || die "cannot extract $*"
	for _m in "$@"; do
		_want=$(awk -v n="$_m" '$2 == n { print $1 }' "$WORK/sums")
		[ -n "$_want" ] || die "$_m is not covered by the manifest"
		[ "$(sha256_of "$WORK/x/$_m")" = "$_want" ] || die "checksum mismatch for $_m"
	done
}

do_install_update() {
	_bundle=$1
	case "$_bundle" in /*) ;; *) die "bundle path must be absolute" ;; esac
	_real=$(readlink -f -- "$_bundle" 2>/dev/null) || die "bundle $_bundle not found"
	[ -e "$_real" ] || die "bundle $_bundle not found"
	case "$_real" in
	/data/* | /run/phonix/*) ;;
	*) die "bundles are only accepted from /data or /run/phonix" ;;
	esac
	[ -f "$_real" ] || die "bundle is not a regular file"
	[ -r "$UPDATE_KEY" ] || die "no update signing key at $UPDATE_KEY"

	_board=$(board)
	[ -n "$_board" ] || die "unknown board (missing $BOARD_FILE)"
	case "$_board" in
	lxc-*)
		install_update_lxc "$_real" "$_board"
		return
		;;
	oci-*) die "PhonixPBX runs in an OCI container: update by replacing the container with a newer image and keep /data" ;;
	esac
	_cur=$(bootctl_current)
	_target=$(bootctl_other "$_cur")
	_base=$(disk_base)
	_part="${_base}$(bootctl_partnum "$_target")"
	[ -b "$_part" ] || die "target partition $_part not found"
	if grep -q "^$_part " /proc/mounts; then die "target partition $_part is in use"; fi

	WORK=
	trap 'rm -rf "$WORK"; boot_ro' EXIT INT TERM
	bundle_open "$_real" "$_board" rootfs.squashfs vmlinuz initramfs

	_small="vmlinuz initramfs"
	grep -qx boot.tar "$WORK/members" && _small="$_small boot.tar"
	# shellcheck disable=SC2086
	bundle_extract "$_real" $_small
	_want_root=$(awk '$2 == "rootfs.squashfs" { print $1 }' "$WORK/sums")
	[ -n "$_want_root" ] || die "rootfs.squashfs is not covered by the manifest"

	# root filesystem -> inactive slot (streamed, then read back and verified)
	_size=$(tar -tvf "$_real" rootfs.squashfs | awk '{ print $3; exit }')
	case "$_size" in '' | *[!0-9]*) die "cannot determine rootfs size" ;; esac
	_psize=$(blockdev --getsize64 "$_part")
	[ "$_size" -le "$_psize" ] || die "rootfs ($_size bytes) does not fit into $_part ($_psize bytes)"

	boot_rw
	bootctl_cancel_trial "$_target"
	log "installing $_version into slot $_target ($_part)"
	tar -xOf "$_real" rootfs.squashfs | dd of="$_part" bs=1M conv=fsync 2>/dev/null ||
		die "writing $_part failed"
	sync
	echo 3 >/proc/sys/vm/drop_caches 2>/dev/null || true
	if [ "$(head -c "$_size" "$_part" | sha256sum | cut -d' ' -f1)" != "$_want_root" ]; then
		dd if=/dev/zero of="$_part" bs=1M count=1 conv=fsync 2>/dev/null || true
		die "verification of the written root filesystem failed"
	fi

	# kernel, initramfs (+ Pi device trees/overlays) -> /slotX on PHXBOOT
	_new="$BOOT_DIR/slot$_target.new"
	rm -rf "$_new"
	mkdir -p "$_new"
	if [ -f "$WORK/x/boot.tar" ]; then
		tar -xf "$WORK/x/boot.tar" -C "$_new" || die "cannot unpack boot.tar"
	fi
	cp "$WORK/x/vmlinuz" "$_new/vmlinuz"
	cp "$WORK/x/initramfs" "$_new/initramfs"
	if [ "$(bootctl_loader)" = rpi ]; then
		# same kernel command line, other slot
		sed "s/phonix\.slot=[AB]/phonix.slot=$_target/" "$BOOT_DIR/slot$_cur/cmdline.txt" >"$_new/cmdline.txt"
	fi
	sync
	rm -rf "$BOOT_DIR/slot$_target"
	mv "$_new" "$BOOT_DIR/slot$_target"
	sync
	printf '%s\n' "$_version" >"$BOOT_DIR/slot$_target/version"

	bootctl_arm_trial "$_target"
	boot_ro
	log "update $_version installed into slot $_target, trial boot armed"
	kmsg "update $_version installed into slot $_target"
	echo "installed $_version into slot $_target - reboot to activate"
}

# LXC system container: no A/B slots, the packages are upgraded in place to
# exactly the package set of the release (the bundle's apk repository and
# world). There is no rollback; the web interface takes a configuration backup
# first and asks for a snapshot on the container host.
install_update_lxc() { # bundle board
	_b=$1
	_bb=$2
	WORK=
	trap 'rm -rf "$WORK"' EXIT INT TERM
	bundle_open "$_b" "$_bb" packages.tar world image-info
	bundle_extract "$_b" world image-info packages.tar

	# world: package names, optionally with a version constraint
	[ -s "$WORK/x/world" ] || die "empty world"
	if grep -Evq '^[A-Za-z0-9][A-Za-z0-9._+-]*([<>=~]+[A-Za-z0-9._+~-]+)?$' "$WORK/x/world"; then
		die "invalid world"
	fi
	grep -qx phonix "$WORK/x/world" || die "world lacks phonix"
	# image-info: shell variable assignments read by other tools
	if grep -Evq '^PHONIX_[A-Z_]+="[A-Za-z0-9._+~:-]*"$' "$WORK/x/image-info"; then
		die "invalid image-info"
	fi

	# the repository: <arch>/APKINDEX.tar.gz and <arch>/*.apk, nothing else
	_arch=$(apk --print-arch)
	tar -tf "$WORK/x/packages.tar" >"$WORK/repo-members" || die "packages.tar is not a tar archive"
	while IFS= read -r _m; do
		case "$_m" in
		"$_arch/" | "$_arch/APKINDEX.tar.gz") ;;
		"$_arch"/*/* | "$_arch"/.*) die "unexpected repository member '$_m'" ;;
		"$_arch"/*.apk) ;;
		*) die "unexpected repository member '$_m' (bundle for another architecture?)" ;;
		esac
	done <"$WORK/repo-members"
	grep -qx "$_arch/APKINDEX.tar.gz" "$WORK/repo-members" || die "packages.tar lacks the package index"
	mkdir "$WORK/repo"
	tar -xf "$WORK/x/packages.tar" -C "$WORK/repo" || die "cannot unpack packages.tar"
	rm -f "$WORK/x/packages.tar"

	# the index is unsigned: packages.tar as a whole is covered by the manifest
	# signature. Nothing comes from the network.
	_apk() {
		apk --no-cache --no-interactive --allow-untrusted --repositories-file /dev/null \
			-X "$WORK/repo" "$@"
	}
	cp /etc/apk/world "$WORK/world.old"
	cp "$WORK/x/world" /etc/apk/world
	if ! _apk upgrade --available --simulate >"$WORK/simulate.log" 2>&1; then
		cp "$WORK/world.old" /etc/apk/world
		log "update $_version: $(tail -n 5 "$WORK/simulate.log" | tr '\n' ' ')"
		die "the packages of $_version cannot be installed: $(tail -n 3 "$WORK/simulate.log" | tr '\n' ' ')"
	fi

	log "installing $_version (packages)"
	kmsg "installing update $_version"
	mkdir -p /var/log/phonix
	_ulog=/var/log/phonix/update.log
	{
		echo "== $(date -u +%Y-%m-%dT%H:%M:%SZ) update to $_version"
		cat "$WORK/simulate.log"
	} >>"$_ulog"
	if ! _apk upgrade --available >>"$_ulog" 2>&1; then
		die "apk upgrade to $_version failed, the system may be partly updated (see $_ulog): $(tail -n 3 "$_ulog" | tr '\n' ' ')"
	fi
	# the rootfs-fixup of the new version
	"$LIBEXEC/rootfs-fixup" / "$_bb" "$_version" >>"$_ulog" 2>&1 ||
		die "rootfs-fixup after the update to $_version failed (see $_ulog)"
	install -m 0644 "$WORK/x/image-info" /usr/share/phonix/image-info
	sync
	log "update $_version installed, restart the container to activate"
	kmsg "update $_version installed"
	echo "installed $_version - restart the container to activate"
}

do_mark_good() {
	! is_container || no_slots_in_container
	_cur=$(bootctl_current)
	if bootctl_is_trial; then
		boot_rw
		bootctl_mark_good
		boot_ro
		log "slot $_cur confirmed"
		kmsg_info "boot slot $_cur marked good (update confirmed)"
		echo "slot $_cur marked good"
	else
		kmsg_info "boot slot $_cur marked good"
		echo "slot $_cur is already permanent"
	fi
}

do_factory_reset() {
	if is_container; then
		# no data partition to format: phonix-firstboot empties /data at the
		# next start when it finds the marker
		mkdir -p /var/lib/phonix
		chmod 700 /var/lib/phonix
		: >/var/lib/phonix/factory-reset
		log "factory reset requested, rebooting"
		detach "sleep 2; /sbin/reboot"
		echo "factory reset scheduled, rebooting"
		return 0
	fi
	boot_rw
	: >"$BOOT_DIR/factory-reset"
	boot_ro
	log "factory reset requested, rebooting"
	kmsg "factory reset requested"
	detach "sleep 2; /sbin/reboot"
	echo "factory reset scheduled, rebooting"
}

# ------------------------------------------------------------------ firewall

ip_family() {
	case "$1" in
	*:*)
		case "$1" in *[!0-9a-fA-F:.]*) return 1 ;; esac
		[ "${#1}" -le 45 ] || return 1
		echo 6
		;;
	*.*.*.*)
		case "$1" in *[!0-9.]*) return 1 ;; esac
		_old_ifs=$IFS
		IFS=.
		# shellcheck disable=SC2086
		set -- $1
		IFS=$_old_ifs
		[ $# -eq 4 ] || return 1
		for _o in "$@"; do
			case "$_o" in '' | ???*?) return 1 ;; esac
			[ "$_o" -le 255 ] || return 1
		done
		echo 4
		;;
	*) return 1 ;;
	esac
}

do_ban() {
	_fam=$(ip_family "$1") || die "invalid IP address $1"
	case "$2" in '' | *[!0-9]*) die "invalid ban duration $2" ;; esac
	[ "${#2}" -le 8 ] && [ "$2" -ge 1 ] && [ "$2" -le 31536000 ] || die "ban duration out of range"
	nft add element inet phonix "banned$_fam" "{ $1 timeout ${2}s }" || die "nft failed"
	log "banned $1 for $2s"
}

do_unban() {
	_fam=$(ip_family "$1") || die "invalid IP address $1"
	nft delete element inet phonix "banned$_fam" "{ $1 }" 2>/dev/null || true
	log "unbanned $1"
}

# ------------------------------------------------------------------ main

[ "$(id -u)" -eq 0 ] || die "must run as root"
[ $# -ge 1 ] || usage
ACTION=$1
shift
for _a in "$@"; do
	valid_arg "$_a" || die "invalid argument"
done

case "$ACTION" in
install-staged)
	nargs 1 $#
	do_install_staged "$1"
	;;
asterisk-restart)
	nargs 0 $#
	if svc_started asterisk; then
		rc-service asterisk restart >/dev/null 2>&1 || die "asterisk restart failed"
	else
		rc-service asterisk start >/dev/null 2>&1 || die "asterisk start failed"
	fi
	;;
asterisk-start)
	nargs 0 $#
	svc_started asterisk || rc-service asterisk start >/dev/null 2>&1 || die "asterisk start failed"
	;;
nginx-reload)
	nargs 0 $#
	nginx -t -q || die "nginx configuration test failed"
	rc-service nginx reload >/dev/null 2>&1 || die "nginx reload failed"
	;;
time-sync)
	nargs 0 $#
	! is_container || die "the clock of a container is set by the container host"
	chronyc -a makestep >/dev/null || die "chronyc makestep failed"
	;;
reboot)
	nargs 0 $#
	log "reboot requested"
	detach "sleep 2; /sbin/reboot"
	;;
shutdown)
	nargs 0 $#
	log "shutdown requested"
	detach "sleep 2; /sbin/poweroff"
	;;
factory-reset)
	nargs 0 $#
	do_factory_reset
	;;
install-update)
	nargs 1 $#
	do_install_update "$1"
	;;
mark-good)
	nargs 0 $#
	do_mark_good
	;;
boot-status)
	# read-only, for diagnostics (not used by the web process)
	nargs 0 $#
	if is_container; then
		echo "board $(board): container, no boot slots"
		exit 0
	fi
	bootctl_status
	;;
ban)
	nargs 2 $#
	do_ban "$1" "$2"
	;;
unban)
	nargs 1 $#
	do_unban "$1"
	;;
*)
	usage
	;;
esac
