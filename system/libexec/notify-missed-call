#!/bin/sh
# Mail a missed call notification. Called by Asterisk (user asterisk) from the
# sub-missed-call hangup handler:
#   notify-missed-call <email> <cause> <callerid>
# The dialplan already filters the arguments; they are still treated as
# untrusted data here (never evaluated, control characters stripped).
set -eu
PATH=/usr/sbin:/usr/bin:/sbin:/bin
MSMTPRC=/etc/phonix/msmtprc

[ $# -eq 3 ] || { echo "usage: notify-missed-call <email> <cause> <callerid>" >&2; exit 64; }

clean() {
	printf '%s' "$1" | tr -d '\000-\037\177' | cut -c1-200
}

to=$(clean "$1")
cause=$(clean "$2")
callerid=$(clean "$3")

case "$to" in
*[!A-Za-z0-9._%+@-]* | *@*@* | @* | *@ | '') echo "notify-missed-call: invalid address" >&2; exit 65 ;;
*@*) ;;
*) echo "notify-missed-call: invalid address" >&2; exit 65 ;;
esac
[ -r "$MSMTPRC" ] || { echo "notify-missed-call: e-mail is not configured" >&2; exit 69; }

host=$(hostname 2>/dev/null || echo phonix)
date=$(date -R)

# send in the background so the dialplan is not blocked by a slow relay
(
	printf 'To: %s\n' "$to"
	printf 'Subject: Missed call from %s\n' "${callerid:-unknown}"
	printf 'Date: %s\n' "$date"
	printf 'Content-Type: text/plain; charset=UTF-8\n'
	printf 'Auto-Submitted: auto-generated\n'
	printf '\n'
	printf 'You missed a call.\n\n'
	printf 'Caller:  %s\n' "${callerid:-unknown}"
	printf 'Reason:  %s\n' "$cause"
	printf 'Time:    %s\n' "$date"
	printf '\n-- \nPhonixPBX on %s\n' "$host"
) | setsid msmtp -C "$MSMTPRC" -t >/dev/null 2>&1 </dev/null &
exit 0
