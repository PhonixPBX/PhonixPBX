# SPDX-FileCopyrightText: 2026 The PhonixPBX contributors
# SPDX-License-Identifier: Apache-2.0
# Rotate the PhonixPBX, Asterisk and nginx logs by size. /var/log is in RAM,
# and a daily check lets a log grow far beyond its limit (e.g. the Asterisk
# security log during a SIP scan). Installed in /etc/periodic/15min; the state
# file stays in RAM too.
exec logrotate -s /var/log/.phonix-logrotate.status /etc/logrotate.d/phonix
