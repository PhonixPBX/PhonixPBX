#!/bin/sh
# SPDX-FileCopyrightText: 2026 The PhonixPBX contributors
# SPDX-License-Identifier: Apache-2.0
# Look for a newer PhonixPBX release (shown on the dashboard); does nothing
# unless "Check automatically" is enabled. Installed in /etc/periodic/daily.
[ -r /etc/conf.d/phonix ] && . /etc/conf.d/phonix
export PHONIX_DATA_DIR PHONIX_BOOT_DIR PHONIX_PRIVILEGED PHONIX_LIBEXEC_DIR

# spread the requests of many PBXs over an hour
sleep $(($(od -An -N2 -tu2 /dev/urandom) % 3600))

su -s /bin/sh -c 'exec phonix update check --auto' phonix 2>&1 | logger -t phonix-update
