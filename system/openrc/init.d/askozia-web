#!/sbin/openrc-run
# AskoziaPBX web interface (FastAPI/uvicorn on a unix socket behind nginx).

description="AskoziaPBX web interface"

: "${socket:=/run/askozia/web.sock}"

[ -r /etc/conf.d/askozia ] && . /etc/conf.d/askozia
export ASKOZIA_DATA_DIR ASKOZIA_BOOT_DIR ASKOZIA_PRIVILEGED ASKOZIA_LIBEXEC_DIR \
	ASKOZIA_AMI_HOST ASKOZIA_AMI_PORT

supervisor=supervise-daemon
command=/usr/bin/askozia
command_args="web --uds $socket"
command_user="askozia:askozia"
directory=/
output_log=/var/log/askozia/web.log
error_log=/var/log/askozia/web.log
respawn_delay=3
respawn_max=0

depend() {
	need localmount
	after askozia-apply asterisk
	before nginx
	use logger
}

start_pre() {
	checkpath -d -m 0711 -o askozia:askozia /run/askozia
	checkpath -d -m 0700 -o askozia:askozia /run/askozia/staged
	checkpath -d -m 0755 -o root:root /var/log/askozia
	checkpath -f -m 0640 -o askozia:askozia /var/log/askozia/web.log
	rm -f "$socket"
}
