#!/sbin/openrc-run
# Regenerate all derived configuration from the database before the system
# services start (replaces the legacy rc.bootup / pbx_configure()).

description="Generate AskoziaPBX system and Asterisk configuration"

depend() {
	need localmount
	after askozia-firstboot
	before hostname networking net nftables firewall chronyd asterisk dropbear nginx msmtp
}

_env() {
	[ -r /etc/conf.d/askozia ] && . /etc/conf.d/askozia
	export ASKOZIA_DATA_DIR ASKOZIA_BOOT_DIR ASKOZIA_PRIVILEGED ASKOZIA_LIBEXEC_DIR \
		ASKOZIA_AMI_HOST ASKOZIA_AMI_PORT
}

_runtime_dirs() {
	checkpath -d -m 0750 -o askozia:asterisk /etc/asterisk /etc/askozia
	checkpath -d -m 0711 -o askozia:askozia /run/askozia
	checkpath -d -m 0700 -o askozia:askozia /run/askozia/staged
	checkpath -d -m 0755 -o root:root /var/log/askozia
	checkpath -d -m 0750 -o asterisk:asterisk /var/run/asterisk /var/log/asterisk \
		/var/lib/asterisk /var/lib/asterisk/keys /var/cache/asterisk
	# the update public key is part of the image (root-owned, world readable)
	[ -e /etc/askozia/update-key.pub ] && chmod 0644 /etc/askozia/update-key.pub
	return 0
}

start() {
	_env
	_runtime_dirs
	ebegin "Generating AskoziaPBX configuration"
	askozia apply --boot >/var/log/askozia/apply-boot.log 2>&1
	local rc=$?
	if [ $rc -ne 0 ]; then
		tail -n 20 /var/log/askozia/apply-boot.log >&2
	fi
	eend $rc "askozia apply failed (see /var/log/askozia/apply-boot.log)"

	# generated config files: askozia:asterisk, not world readable
	chown -R askozia:asterisk /etc/asterisk
	find /etc/asterisk -type f -exec chmod 0640 {} +

	# time zone
	local tz
	tz=$(head -n 1 /etc/timezone 2>/dev/null | tr -d '[:space:]')
	if [ -n "$tz" ] && [ -f "/usr/share/zoneinfo/$tz" ]; then
		ln -sfn "/usr/share/zoneinfo/$tz" /etc/localtime
	fi

	# ssh on/off (runlevels live on the tmpfs overlay: decided on every boot)
	if [ "$(head -n 1 /etc/askozia/ssh 2>/dev/null)" = on ]; then
		ln -sfn /etc/init.d/dropbear /etc/runlevels/default/dropbear
	else
		rm -f /etc/runlevels/default/dropbear
	fi

	# a failed generator must not leave the box unreachable: keep the
	# image defaults (DHCP on eth0, permissive firewall) in that case
	return 0
}
