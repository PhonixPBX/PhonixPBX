#!/sbin/openrc-run
# Prepare the persistent data partition (every boot) and run the idempotent
# "askozia firstboot" (directories, secrets, DB migrations, seed data, legacy
# config.xml import, initial admin password, self-signed TLS certificate).

description="Prepare AskoziaPBX data partition"

: "${ASKOZIA_DATA_DIR:=/data}"
: "${ASKOZIA_BOOT_DIR:=/media/boot}"

depend() {
	need localmount
	after bootmisc clock
	before askozia-apply
}

_env() {
	[ -r /etc/conf.d/askozia ] && . /etc/conf.d/askozia
	export ASKOZIA_DATA_DIR ASKOZIA_BOOT_DIR ASKOZIA_PRIVILEGED ASKOZIA_LIBEXEC_DIR \
		ASKOZIA_AMI_HOST ASKOZIA_AMI_PORT
}

_prepare_dirs() {
	local d="$ASKOZIA_DATA_DIR"
	checkpath -d -m 0750 -o askozia:asterisk "$d"
	checkpath -d -m 0750 -o askozia:askozia "$d/state" "$d/backups" "$d/tmp"
	checkpath -d -m 0750 -o askozia:asterisk "$d/tls"
	# setgid: new media files keep group asterisk (Asterisk reads MOH/greetings)
	checkpath -d -m 2750 -o askozia:asterisk "$d/media"
	checkpath -d -m 0750 -o asterisk:asterisk "$d/asterisk" "$d/spool"
	checkpath -d -m 0700 -o root:root "$d/ssh" "$d/ssh/dropbear"
	checkpath -d -m 0700 -o nginx:nginx "$d/tmp/nginx"
	checkpath -d -m 0755 -o root:root "$d/log"

	# machine-id lives on the data partition
	if [ ! -s "$d/machine-id" ]; then
		tr -d '-' </proc/sys/kernel/random/uuid >"$d/machine-id"
	fi
	ln -sfn "$d/machine-id" /etc/machine-id

	# voicemail and other spool data persist
	if ! mountpoint -q /var/spool/asterisk; then
		checkpath -d -m 0750 -o asterisk:asterisk /var/spool/asterisk
		mount --bind "$d/spool" /var/spool/asterisk
	fi
}

_fix_ownership() {
	local d="$ASKOZIA_DATA_DIR" f
	for f in "$d"/askozia.db "$d"/askozia.db-wal "$d"/askozia.db-shm "$d"/secrets.json; do
		[ -e "$f" ] && chown askozia:askozia "$f" && chmod 0640 "$f"
	done
	chown -R askozia:askozia "$d/state" "$d/backups"
	chown -R askozia:asterisk "$d/media"
	find "$d/media" -type d -exec chmod g+s {} +
	chown askozia:asterisk "$d/tls" "$d/tls"/* 2>/dev/null
	[ -e "$d/tls/server.key" ] && chmod 0640 "$d/tls/server.key"
	[ -e "$d/tls/server.crt" ] && chmod 0644 "$d/tls/server.crt"
	return 0
}

start() {
	_env
	ebegin "Preparing AskoziaPBX data partition"
	_prepare_dirs
	eend $? || return 1

	local remounted=0
	if mountpoint -q "$ASKOZIA_BOOT_DIR" && \
	   { [ -f "$ASKOZIA_BOOT_DIR/config.xml" ] || [ -f "$ASKOZIA_BOOT_DIR/conf/config.xml" ]; }; then
		# legacy config.xml import renames the file on the boot partition
		mount -o remount,rw "$ASKOZIA_BOOT_DIR" && remounted=1
	fi

	ebegin "Initialising AskoziaPBX"
	local log="$ASKOZIA_DATA_DIR/state/firstboot.log" rc
	( umask 077; askozia firstboot >"$log.new" 2>&1 )
	rc=$?
	# the output contains the initial password: root-only
	mv -f "$log.new" "$log"
	chown root:root "$log"
	chmod 0600 "$log"
	if [ "$remounted" = 1 ]; then
		sync
		mount -o remount,ro "$ASKOZIA_BOOT_DIR"
	fi
	_fix_ownership
	if [ $rc -ne 0 ]; then
		grep -v -i password "$log" | tail -n 20 >&2
	fi
	eend $rc "askozia firstboot failed (see $log)"
}
