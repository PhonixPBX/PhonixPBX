#!/sbin/openrc-run
# Prepare the persistent data partition (every boot) and run the idempotent
# "phonix firstboot" (directories, secrets, DB migrations, seed data, legacy
# config.xml import, initial admin password, self-signed TLS certificate).

description="Prepare PhonixPBX data partition"

: "${PHONIX_DATA_DIR:=/data}"
: "${PHONIX_BOOT_DIR:=/media/boot}"

depend() {
	need localmount
	after bootmisc clock
	before phonix-apply
}

_env() {
	[ -r /etc/conf.d/phonix ] && . /etc/conf.d/phonix
	export PHONIX_DATA_DIR PHONIX_BOOT_DIR PHONIX_PRIVILEGED PHONIX_LIBEXEC_DIR \
		PHONIX_AMI_HOST PHONIX_AMI_PORT
}

_prepare_dirs() {
	local d="$PHONIX_DATA_DIR"
	checkpath -d -m 0750 -o phonix:asterisk "$d"
	checkpath -d -m 0750 -o phonix:phonix "$d/state" "$d/backups" "$d/tmp"
	checkpath -d -m 0750 -o phonix:asterisk "$d/tls"
	# setgid: new media files keep group asterisk (Asterisk reads MOH/greetings)
	checkpath -d -m 2750 -o phonix:asterisk "$d/media"
	checkpath -d -m 0750 -o asterisk:asterisk "$d/asterisk" "$d/spool"
	checkpath -d -m 0700 -o root:root "$d/ssh" "$d/ssh/dropbear"
	checkpath -d -m 0700 -o nginx:nginx "$d/tmp/nginx"
	checkpath -d -m 0755 -o root:root "$d/log"

	# machine-id lives on the data partition
	if [ ! -s "$d/machine-id" ]; then
		tr -d '-' </proc/sys/kernel/random/uuid >"$d/machine-id"
	fi
	ln -sfn "$d/machine-id" /etc/machine-id

	# voicemail and other spool data persist (container images link
	# /var/spool/asterisk to /data/spool instead)
	if [ ! -L /var/spool/asterisk ] && ! mountpoint -q /var/spool/asterisk; then
		checkpath -d -m 0750 -o asterisk:asterisk /var/spool/asterisk
		mount --bind "$d/spool" /var/spool/asterisk || ewarn "cannot bind mount $d/spool on /var/spool/asterisk"
	fi
	return 0
}

# Container boards have no PHXDATA partition the initramfs could format: a
# factory reset requested by "priv factory-reset" leaves a (root-only)
# marker and the data directory is emptied here, before anything uses it.
_factory_reset() {
	local d="$PHONIX_DATA_DIR" marker=/var/lib/phonix/factory-reset
	[ -e "$marker" ] || return 0
	case "$d" in /?*) ;; *) eerror "refusing factory reset of '$d'"; return 1 ;; esac
	ewarn "Factory reset: erasing $d"
	find "$d" -mindepth 1 -maxdepth 1 ! -name lost+found -exec rm -rf {} + &&
		rm -f "$marker"
}

_fix_ownership() {
	local d="$PHONIX_DATA_DIR" f
	for f in "$d"/phonix.db "$d"/phonix.db-wal "$d"/phonix.db-shm "$d"/secrets.json; do
		[ -e "$f" ] && chown phonix:phonix "$f" && chmod 0640 "$f"
	done
	chown -R phonix:phonix "$d/state" "$d/backups"
	chown -R phonix:asterisk "$d/media"
	find "$d/media" -type d -exec chmod g+s {} +
	chown phonix:asterisk "$d/tls" "$d/tls"/* 2>/dev/null
	[ -e "$d/tls/server.key" ] && chmod 0640 "$d/tls/server.key"
	[ -e "$d/tls/server.crt" ] && chmod 0644 "$d/tls/server.crt"
	return 0
}

start() {
	_env
	_factory_reset || return 1
	ebegin "Preparing PhonixPBX data partition"
	_prepare_dirs
	eend $? || return 1

	local remounted=0
	if mountpoint -q "$PHONIX_BOOT_DIR" && \
	   { [ -f "$PHONIX_BOOT_DIR/config.xml" ] || [ -f "$PHONIX_BOOT_DIR/conf/config.xml" ]; }; then
		# legacy config.xml import renames the file on the boot partition
		mount -o remount,rw "$PHONIX_BOOT_DIR" && remounted=1
	fi

	ebegin "Initialising PhonixPBX"
	local log="$PHONIX_DATA_DIR/state/firstboot.log" rc
	( umask 077; phonix firstboot >"$log.new" 2>&1 )
	rc=$?
	# the output contains the initial password: root-only
	mv -f "$log.new" "$log"
	chown root:root "$log"
	chmod 0600 "$log"
	if [ "$remounted" = 1 ]; then
		sync
		mount -o remount,ro "$PHONIX_BOOT_DIR"
	fi
	_fix_ownership
	if [ $rc -ne 0 ]; then
		grep -v -i password "$log" | tail -n 20 >&2
	fi
	eend $rc "phonix firstboot failed (see $log)"
}
