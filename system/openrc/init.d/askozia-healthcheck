#!/sbin/openrc-run
# Confirms the booted A/B slot once the web interface and Asterisk are up
# (askozia healthcheck --mark-good). An unconfirmed trial boot of an update
# is rolled back by rebooting into the previous slot. The check loop runs
# detached (healthcheck-loop) so it does not delay the boot; its result is in
# /var/log/askozia/healthcheck.log and the kernel log.

description="AskoziaPBX boot health check / A/B slot confirmation"

depend() {
	after askozia-web nginx asterisk
}

start() {
	[ -r /etc/conf.d/askozia ] && . /etc/conf.d/askozia
	export ASKOZIA_DATA_DIR ASKOZIA_BOOT_DIR ASKOZIA_PRIVILEGED ASKOZIA_LIBEXEC_DIR \
		ASKOZIA_AMI_HOST ASKOZIA_AMI_PORT ASKOZIA_HEALTHCHECK_TIMEOUT
	checkpath -d -m 0755 -o root:root /var/log/askozia
	checkpath -f -m 0640 -o askozia:askozia /var/log/askozia/healthcheck.log
	ebegin "Starting AskoziaPBX health check"
	start-stop-daemon --start --background --user askozia:askozia --chdir / \
		--stdout /var/log/askozia/healthcheck.log --stderr /var/log/askozia/healthcheck.log \
		--exec /usr/libexec/askozia/healthcheck-loop
	eend $?
}

stop() {
	ebegin "Stopping AskoziaPBX health check"
	pkill -f /usr/libexec/askozia/healthcheck-loop 2>/dev/null
	eend 0
}
