# Generated by AskoziaPBX - do not edit, changes will be overwritten.
defaults
logfile -
syslog LOG_MAIL
{% if email.configured %}

account default
host {{ email.host }}
port {{ email.port }}
from {{ email.from_address }}
{% if email.encryption == "none" %}
tls off
{% else %}
tls on
tls_starttls {{ "on" if email.encryption == "starttls" else "off" }}
tls_trust_file /etc/ssl/certs/ca-certificates.crt
tls_certcheck {{ "on" if email.verify_cert else "off" }}
{% endif %}
{% if email.auth %}
auth on
user {{ email.username | msmtp_quote }}
password {{ email.password | msmtp_quote }}
{% else %}
auth off
{% endif %}
{% endif %}
