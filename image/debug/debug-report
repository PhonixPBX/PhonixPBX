# SPDX-License-Identifier: Apache-2.0
# Debug images only: hardware, boot and console diagnostics in one report.
#   ssh root@<address> debug-report >report.txt
PATH=/usr/sbin:/usr/bin:/sbin:/bin

section() {
	printf '\n===== %s\n' "$*"
}

run() {
	section "$*"
	sh -c "$*" 2>&1
}

run cat /usr/share/phonix/image-info
run uname -a
run cat /proc/device-tree/model
run cat /proc/cmdline
run cat /sys/class/tty/console/active
run "ps -o pid,tty,args | grep -E 'console|tui' | grep -v grep"
run "cat /sys/class/graphics/fb*/name"
run "ls -l /dev/fb* /dev/dri /dev/input 2>&1"
run "cat /proc/bus/input/devices"
run lsmod
run "ls /media/boot /media/boot/slot*"
run "cat /media/boot/config.txt /media/boot/usercfg.txt /media/boot/slot.txt"
run "cat /media/boot/slot*/cmdline.txt"
run "vcgencmd version; vcgencmd get_config int"
run lsblk
run "ip addr"
run "dmesg | grep -iE 'vc4|v3d|simple|fbcon|drm|framebuffer|hdmi'"
run "dmesg | grep -iE 'usb|input|hid|xhci|dwc'"
run dmesg
