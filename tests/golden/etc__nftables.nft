#!/usr/sbin/nft -f
# Generated by PhonixPBX - do not edit, changes will be overwritten.
table inet phonix
delete table inet phonix

table inet phonix {
	set banned4 {
		type ipv4_addr
		flags timeout
	}
	set banned6 {
		type ipv6_addr
		flags timeout
	}
	set ami4 {
		type ipv4_addr
		flags interval
		elements = { 192.168.1.0/24 }
	}

	chain input {
		type filter hook input priority filter; policy drop;
		ct state established,related accept
		ct state invalid drop
		iif lo accept
		ip saddr @banned4 drop
		ip6 saddr @banned6 drop
		meta l4proto icmp accept
		meta l4proto ipv6-icmp accept
		udp sport 67 udp dport 68 accept
		udp dport 546 accept

		# mDNS (<hostname>.local)
		ip daddr 224.0.0.251 udp dport 5353 accept
		ip6 daddr ff02::fb udp dport 5353 accept

		# web interface
		tcp dport { 80, 443 } accept

		# telephony signalling
		udp dport 5060 accept
		udp dport 4569 accept


		# manager interface (AMI) for the networks of the manager users
		ip saddr @ami4 tcp dport 5038 accept

		# media
		udp dport 10000-20000 accept
	}

	chain forward {
		type filter hook forward priority filter; policy drop;
	}

	chain output {
		type filter hook output priority filter; policy accept;
	}
}
