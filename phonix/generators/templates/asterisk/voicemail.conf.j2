{{ header() }}
[general]
format=wav49|wav
serveremail={{ from_address }}
fromstring={{ vm.from_name | cfg }}
attach={{ vm.attach_audio | yesno }}
delete={{ (not vm.keep_messages and email_ok) | yesno }}
maxsecs={{ vm.max_message_seconds }}
minsecs=1
maxlogins=3
skipms=3000
review=no
operator=no
saycid=no
sendvoicemail=no
pollmailboxes=no
charset=UTF-8
; subject and text are replaced by the mailbox's language by the mailcmd
; (phonix.notify, texts in phonix-notify.json); these lines only carry the details
emaildateformat=%Y-%m-%dT%H:%M:%S%z
mailcmd=/usr/libexec/phonix/notify voicemail
emailsubject=PHONIX-VM ${VM_MAILBOX}
emailbody=mailbox=${VM_MAILBOX}\nmsgnum=${VM_MSGNUM}\nname=${VM_NAME}\ncallerid=${VM_CALLERID}\ndur=${VM_DUR}\ndate=${VM_DATE}\n

[zonemessages]

[default]
{% for p in phones %}
{{ p.extension }} => {{ p.vm_pin or "0000" }},{{ p.callerid | replace(",", " ") }},{{ p.vm_email if email_ok else "" }},,attach={{ vm.attach_audio | yesno }}|delete={{ (not vm.keep_messages and email_ok and p.vm_email != "") | yesno }}
{% endfor %}
