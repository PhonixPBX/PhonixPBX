{{ header() }}
[global]
type=global
user_agent=PhonixPBX
endpoint_identifier_order=ip,username,anonymous
max_initial_qualify_time=4
{% for line in manual_lines(sip.manual_attributes) %}
{{ line }}
{% endfor %}

[system]
type=system

;
; transports
;
{% for t in transports %}
[transport-{{ t.protocol }}]
type=transport
protocol={{ t.protocol }}
bind=0.0.0.0:{{ t.port }}
{% if t.protocol == "tls" %}
cert_file={{ tls_cert }}
priv_key_file={{ tls_key }}
method=tlsv1_2
{% endif %}
{% if nat.enabled %}
local_net={{ nat.local_net }}
local_net=127.0.0.0/8
{% if nat.external %}
external_media_address={{ nat.external }}
external_signaling_address={{ nat.external }}
{% endif %}
{% endif %}

{% endfor %}
;
; endpoint used to dial external phones configured as plain SIP URIs
;
[uri-dial]
type=endpoint
context=no-inbound
disallow=all
allow=g722,alaw,ulaw
direct_media=no
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes

;
; providers
;
{% for p in providers %}
; {{ p.name }}
{% if p.registration %}
[prov-{{ p.id }}-reg]
type=registration
transport=transport-{{ p.transport }}
outbound_auth=prov-{{ p.id }}-auth
server_uri=sip:{{ p.host }}{% if p.port %}:{{ p.port }}{% endif %}{% if p.transport == "tcp" %};transport=tcp{% endif %}

client_uri=sip:{{ p.username }}@{{ p.host }}{% if p.port %}:{{ p.port }}{% endif %}

contact_user={{ p.username }}
expiration={{ sip.default_expiry }}
retry_interval=60
forbidden_retry_interval=600
fatal_retry_interval=600
max_retries=10000
line=yes
endpoint=prov-{{ p.id }}

{% endif %}
[prov-{{ p.id }}-auth]
type=auth
auth_type=userpass
username={{ p.auth_user or p.username }}
password={{ p.secret }}

[prov-{{ p.id }}]
type=aor
contact=sip:{{ p.host }}{% if p.port %}:{{ p.port }}{% endif %}

qualify_frequency={{ p.qualify }}

[prov-{{ p.id }}]
type=endpoint
transport=transport-{{ p.transport }}
context={{ provider_context[p.id] }}
disallow=all
allow={{ p.codecs | join(",") }}
outbound_auth=prov-{{ p.id }}-auth
aors=prov-{{ p.id }}
from_user={{ p.from_user or p.username }}
from_domain={{ p.from_domain or p.host }}
language={{ p.language }}
direct_media=no
dtmf_mode={{ p.dtmf_mode }}
{% if p.nat %}
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes
{% endif %}
{% if srtp %}
media_encryption=sdes
media_encryption_optimistic=yes
{% endif %}
{% for line in manual_lines(p.manual_attributes) %}
{{ line }}
{% endfor %}

{% if p.id in identify %}
[prov-{{ p.id }}-identify]
type=identify
endpoint=prov-{{ p.id }}
match={{ p.host }}

{% endif %}
{% endfor %}
;
; phones
;
{% for p in phones %}
; {{ p.callerid }} <{{ p.extension }}>{% if p.description %} - {{ p.description }}{% endif %}

[{{ p.extension }}]
type=endpoint
context=phone-{{ p.extension }}
disallow=all
allow={{ p.codecs | join(",") }}
auth={{ p.extension }}
aors={{ p.extension }}
callerid={{ p.callerid | quote }} <{{ p.extension }}>
language={{ p.language }}
direct_media=no
dtmf_mode={{ p.dtmf_mode }}
{% if p.nat %}
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes
{% endif %}
{% if p.vm_enabled %}
mailboxes={{ p.extension }}@default
{% endif %}
{% if p.busylevel %}
device_state_busy_at={{ p.busylevel }}
{% endif %}
named_call_group=phonix
named_pickup_group=phonix
allow_subscribe=yes
send_pai=yes
{% if srtp %}
media_encryption=sdes
media_encryption_optimistic=yes
{% endif %}
{% for line in manual_lines(p.manual_attributes) %}
{{ line }}
{% endfor %}

[{{ p.extension }}]
type=auth
auth_type=userpass
username={{ p.extension }}
password={{ p.secret }}

[{{ p.extension }}]
type=aor
max_contacts={{ p.max_contacts }}
remove_existing=yes
qualify_frequency={{ p.qualify }}

{% endfor %}
